# Kopier til .env.local og fyll inn. Lokale verdier for Supabase får du med `npx supabase status`.

# Produktnavn og domene (ikke bestemt ennå)
NEXT_PUBLIC_PRODUCT_NAME=Boligplattform
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (EU). Den hemmelige nøkkelen brukes bare på server: leads og delt forhåndsvisning
# av prosjektsiden. Lokalt: SECRET_KEY fra `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# E-post (Resend). Uten nøkkel sendes e-post til Mailpit når MAILPIT_URL er satt
# (lokal Supabase, se `npx supabase status`), ellers skrives den til serverloggen.
RESEND_API_KEY=
EMAIL_FROM="Boligplattform <noreply@example.com>"
MAILPIT_URL=http://127.0.0.1:54324

# Cloudflare Turnstile på interesseskjemaet. Uten nøkler brukes bare honeypot og rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (EU-region). Uten DSN er feilsporing av.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe Billing. Uten nøkkel vises planene, men de kan ikke velges.
# Webhooken i Stripe skal peke til {NEXT_PUBLIC_APP_URL}/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# true når Stripe Tax er satt opp, så mva. legges til i Checkout.
STRIPE_AUTOMATIC_TAX=

# Egne domener (Vercel Domains API). Uten token sjekkes domener bare med DNS.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# DNS-oppslag og hva egne domener skal peke på. Standardverdiene passer for Vercel.
# DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query
# DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# DOMAIN_A_RECORD=76.76.21.21
# DOMAIN_TXT_PREFIX=_boligplattform

# Planlagte jobber (Vercel Cron): webhooks hvert minutt, domener hvert femte
# minutt og varsler om prøveperioden daglig. Vercel sender hemmeligheten selv.
CRON_SECRET=

# Vises på Abonnement-siden for avtaler utenom planene.
SUPPORT_EMAIL=
