# Kopier til .env.local og fyll inn. Lokale verdier for Supabase får du med `npx supabase status`.

# Produktnavn og domene (ikke bestemt ennå)
NEXT_PUBLIC_PRODUCT_NAME=Boligplattform
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (EU). Den hemmelige nøkkelen brukes bare på server.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# E-post (Resend). Uten nøkkel skrives e-post til serverloggen i stedet for å sendes.
RESEND_API_KEY=
EMAIL_FROM="Boligplattform <noreply@example.com>"

# Sentry (EU-region). Uten DSN er feilsporing av.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
